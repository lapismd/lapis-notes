{
  "desktop": {
    "app": {
      "name": "LapisNotes",
      "identifier": "md.lapis.notes.desktop-deno"
    },
    "backend": "webview"
  },
  "imports": {
    "@codemirror/language": "npm:@codemirror/language@6.11.3",
    "@lapis-notes/api/language-service": "../api/src/lib/language-service/index.ts",
    "@lapis-notes/language-service/markdownlint/runtime": "../language-service/src/markdownlint/runtime.ts",
    "@lapismd/ai-host": "../../../ai-host/src/index.ts",
    "@lapismd/terminal-host/deno": "../../../terminal-host/src/deno.ts",
    "@lezer/common": "npm:@lezer/common@1.2.3",
    "@lezer/highlight": "npm:@lezer/highlight@1.2.1",
    "@lezer/lr": "npm:@lezer/lr@1.4.2",
    "@tursodatabase/database": "npm:@tursodatabase/database@0.7.2",
    "@modelcontextprotocol/sdk/server/index.js": "npm:@modelcontextprotocol/sdk@1.29.0/server/index.js",
    "@modelcontextprotocol/sdk/server/streamableHttp.js": "npm:@modelcontextprotocol/sdk@1.29.0/server/streamableHttp.js",
    "@modelcontextprotocol/sdk/server/webStandardStreamableHttp.js": "npm:@modelcontextprotocol/sdk@1.29.0/server/webStandardStreamableHttp.js",
    "@modelcontextprotocol/sdk/types.js": "npm:@modelcontextprotocol/sdk@1.29.0/types.js",
    "@opentelemetry/api": "npm:@opentelemetry/api@1.9.1",
    "acpx/runtime": "npm:acpx@0.13.0/runtime",
    "markdownlint": "npm:markdownlint@0.40.0",
    "markdownlint/sync": "npm:markdownlint@0.40.0/sync",
    "ws": "npm:ws@8.18.3"
  },
  "nodeModulesDir": "none",
  "tasks": {
    "dev": "deno desktop --quiet --hmr --no-check --sloppy-imports --exclude node_modules --exclude dist --exclude src -A src-deno/main.ts",
    "start": "deno desktop --quiet --no-check --sloppy-imports --exclude node_modules --exclude dist --exclude src -A src-deno/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window"]
  }
}
