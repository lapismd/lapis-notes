{
  "name": "@lapis-notes/desktop-deno",
  "productName": "Lapis Notes",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "2026.31.5",
  "description": "Deno desktop host for Lapis Notes",
  "author": "Lapis Notes contributors",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:cef": "LAPIS_DENO_BACKEND=cef node scripts/dev.mjs",
    "dev:chrome": "pnpm dev:cef",
    "dev:telemetry": "node scripts/dev.mjs --telemetry",
    "dev:telemetry:cef": "LAPIS_DENO_BACKEND=cef node scripts/dev.mjs --telemetry",
    "telemetry:lgtm": "node scripts/run-lgtm.mjs",
    "icons:build": "node scripts/generate-build-icons.mjs",
    "dev:vite": "vite",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "package:prepare": "pnpm --dir ../.. build:desktop",
    "package:app": "pnpm package:prepare && node scripts/package-app.mjs",
    "package:macos:arm64": "pnpm package:prepare && node scripts/package-app.mjs --target aarch64-apple-darwin",
    "package:macos:x64": "pnpm package:prepare && node scripts/package-app.mjs --target x86_64-apple-darwin",
    "package:linux:arm64": "pnpm package:prepare && node scripts/package-app.mjs --target aarch64-unknown-linux-gnu",
    "package:linux:x64": "pnpm package:prepare && node scripts/package-app.mjs --target x86_64-unknown-linux-gnu",
    "preview": "vite preview",
    "check": "pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@lapis-notes/ai": "workspace:*",
    "@lapis-notes/api": "workspace:*",
    "@lapis-notes/bases": "workspace:*",
    "@lapis-notes/bookmarks": "workspace:*",
    "@lapis-notes/file-explorer": "workspace:*",
    "@lapis-notes/graph": "workspace:*",
    "@lapis-notes/history": "workspace:*",
    "@lapis-notes/language-service": "workspace:*",
    "@lapis-notes/lapis-plugin-cv-roles": "link:../../../lapis-plugin-cv-roles",
    "@lapis-notes/lapis-plugin-terminal": "link:../../../lapis-plugin-terminal",
    "@lapis-notes/markdown": "workspace:*",
    "@lapis-notes/markdown-lint": "workspace:*",
    "@lapis-notes/search": "workspace:*",
    "@lapis-notes/spellcheck": "workspace:*",
    "@lapis-notes/ui": "workspace:*",
    "@lapis-notes/wordcount": "workspace:*",
    "@lapis-notes/workspace": "workspace:*",
    "@lapismd/ai-host": "link:../../../ai-host",
    "@lapismd/design-core": "*",
    "@lapismd/terminal-host": "link:../../../terminal-host",
    "@lucide/svelte": "^0.523.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.12",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^22.10.5",
    "acpx": "^0.13.0",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.8",
    "ws": "^8.18.3"
  }
}
