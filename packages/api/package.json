{
  "name": "@lapis-notes/api",
  "version": "0.0.1",
  "description": "Lapis Notes API",
  "type": "module",
  "dependencies": {
    "@lapismd/ai-host": "^0.1.0",
    "@lapismd/design-core": "^0.1.0",
    "@lapismd/mira": "^0.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@tursodatabase/database-wasm": "0.7.2",
    "@iconify-json/lucide": "^1.2.63",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^2.3.0",
    "@lezer/common": "^1.2.3",
    "@lezer/lr": "^1.4.2",
    "@lucide/svelte": "^0.523.0",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "@tanstack/svelte-virtual": "^3.13.12",
    "@tanstack/virtual-core": "^3.13.12",
    "@types/lodash-es": "^4.17.12",
    "bits-ui": "2.18.1",
    "clsx": "^2.1.1",
    "eventemitter3": "^5.0.1",
    "fflate": "^0.8.3",
    "lodash-es": "^4.17.21",
    "lucide-static": "^0.503.0",
    "lucide-svelte": "^0.487.0",
    "luxon": "^3.7.1",
    "minimatch": "^10.2.5",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^0.3.1",
    "zod": "^3.25.76"
  },
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm --dir ../.. check:no-tailwind packages/api/src/lib/components && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --fail-on-warnings --output human",
    "check:types": "tsc --noEmit -p tsconfig.types.json",
    "dev": "pnpm --dir ../.. storybook",
    "storybook": "pnpm --dir ../.. storybook",
    "test": "vitest run",
    "test:run": "vitest run",
    "generate:search-query-parser": "lezer-generator ./src/lib/search-query/search-query.grammar -o ./src/lib/search-query/parser.js",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint",
    "parity:generate": "node ./scripts/generate-obsidian-parity.mjs",
    "performance:metadata:native": "tsx ./scripts/metadata-performance-native.ts"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/enhance.js",
    "./src/lib/enhance.ts"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "app-database": [
        "dist/app-database-host.d.ts"
      ],
      "telemetry": [
        "dist/telemetry.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "@lapis-notes/ui": "^0.0.1",
    "@lapismd/design-core": "^0.1.0",
    "@lapismd/mira": "^0.0.1",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.3",
    "i18next": "^25.3.0",
    "svelte": "^5.0.0",
    "svelte-sonner": "^1.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache.svelte.d.ts",
      "svelte": "./dist/cache.svelte.js",
      "import": "./dist/cache.svelte.js",
      "default": "./dist/cache.svelte.js"
    },
    "./metadata-value": {
      "types": "./dist/metadata-value.d.ts",
      "import": "./dist/metadata-value.js",
      "default": "./dist/metadata-value.js"
    },
    "./language-service": {
      "types": "./dist/language-service/index.d.ts",
      "import": "./dist/language-service/index.js",
      "default": "./dist/language-service/index.js"
    },
    "./language-service/worker": {
      "types": "./dist/language-service/worker-provider.d.ts",
      "import": "./dist/language-service/worker-provider.js",
      "default": "./dist/language-service/worker-provider.js"
    },
    "./editor/language-service": {
      "types": "./dist/components/editor/language-service/index.d.ts",
      "import": "./dist/components/editor/language-service/index.js",
      "default": "./dist/components/editor/language-service/index.js"
    },
    "./editor/core": {
      "types": "./dist/components/editor/editor.d.ts",
      "import": "./dist/components/editor/editor.js",
      "default": "./dist/components/editor/editor.js"
    },
    "./workspace-host": {
      "types": "./dist/workspace-host.d.ts",
      "svelte": "./dist/workspace-host.js",
      "import": "./dist/workspace-host.js",
      "default": "./dist/workspace-host.js"
    },
    "./desktop-native": {
      "types": "./dist/storage/desktop-native.d.ts",
      "import": "./dist/storage/desktop-native.js",
      "default": "./dist/storage/desktop-native.js"
    },
    "./app-database": {
      "types": "./dist/app-database-host.d.ts",
      "import": "./dist/app-database-host.js",
      "default": "./dist/app-database-host.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry.d.ts",
      "import": "./dist/telemetry.js",
      "default": "./dist/telemetry.js"
    },
    "./agent-tools": {
      "types": "./dist/agent-tools.d.ts",
      "import": "./dist/agent-tools.js",
      "default": "./dist/agent-tools.js"
    },
    "./agent-skills": {
      "types": "./dist/agent-skills.d.ts",
      "import": "./dist/agent-skills.js",
      "default": "./dist/agent-skills.js"
    },
    "./path": {
      "types": "./dist/storage/path.d.ts",
      "import": "./dist/storage/path.js",
      "default": "./dist/storage/path.js"
    },
    "./vault": {
      "types": "./dist/vault-api.d.ts",
      "svelte": "./dist/vault-api.js",
      "import": "./dist/vault-api.js",
      "default": "./dist/vault-api.js"
    },
    "./plugin-assets": {
      "types": "./dist/plugin-assets.d.ts",
      "import": "./dist/plugin-assets.js",
      "default": "./dist/plugin-assets.js"
    },
    "./search-embedding-worker": {
      "import": "./dist/storage/search-embedding-worker.js",
      "default": "./dist/storage/search-embedding-worker.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "svelte": "./dist/components/*/index.js",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    }
  },
  "devDependencies": {
    "@tursodatabase/database": "0.7.2",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lezer/markdown": "^1.4.3",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@lezer/generator": "^1.7.3",
    "@lezer/highlight": "^1.2.1",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "autoprefixer": "^10.4.21",
    "fake-indexeddb": "^6.2.5",
    "i18next": "^25.3.0",
    "jsdom": "^26.1.0",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "svelte-sonner": "^1.0.5",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "license": "Apache-2.0"
}
