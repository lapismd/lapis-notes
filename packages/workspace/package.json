{
  "name": "@lapis-notes/workspace",
  "version": "0.1.0",
  "description": "Lapis Notes workspace shell backed by design-core",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-notes.git",
    "directory": "packages/workspace"
  },
  "homepage": "https://github.com/lapismd/lapis-notes/tree/main/packages/workspace#readme",
  "bugs": {
    "url": "https://github.com/lapismd/lapis-notes/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm --dir ../.. check:no-tailwind packages/workspace/src/lib && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE.md",
    "README.md",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@lapis-notes/api": "^0.1.0",
    "@lapismd/design-core": "^0.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "tslib": "^2.8.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
