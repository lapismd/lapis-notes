{
  "name": "@lapis-notes/web",
  "private": true,
  "version": "2026.6.3",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm generate-icons && vite build",
    "preview": "vite preview",
    "check": "pnpm check:svelte && pnpm check:types && pnpm check:e2e",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "check:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test -c ./playwright.config.ts",
    "generate-icons": "node ./scripts/generate-pwa-icons.mjs"
  },
  "dependencies": {
    "@lapis-notes/api": "workspace:*",
    "@lapis-notes/file-explorer": "workspace:*",
    "@lapis-notes/markdown": "workspace:*",
    "@lapis-notes/markdown-lint": "workspace:*",
    "@lapis-notes/lapis-plugin-cv-roles": "link:../../../lapis-plugin-cv-roles",
    "@lapis-notes/search": "workspace:*",
    "@lapis-notes/ui": "workspace:*",
    "@lapis-notes/workspace": "workspace:*",
    "@lapismd/design-core": "*",
    "@lucide/svelte": "^0.523.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.12",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.0.0",
    "sharp": "^0.35.0",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
