{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "types": ["node", "@playwright/test"]
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts",
    "../playwright.rust-server.config.ts",
    "../playwright.rust-static.config.ts",
    "../playwright.rust-metadata.config.ts",
    "../playwright.rust-provider.config.ts",
    "../playwright.rust-tasks.config.ts"
  ]
}
