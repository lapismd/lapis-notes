{
  "id": "spellcheck",
  "name": "Spell Check",
  "version": "0.0.1",
  "minAppVersion": "0.0.1",
  "description": "Harper grammar and spelling diagnostics for open notes",
  "author": "Lapis Notes",
  "authorUrl": "https://app.lapis.md",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@lapis-notes/api/language-service",
            "svelte",
            "clsx"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    },
    "contributes": {
      "configuration": [
        {
          "id": "spellcheck",
          "title": "Spell Check",
          "properties": {
            "dialect": {
              "type": "string",
              "title": "Dialect",
              "default": "american"
            },
            "automaticChecking": {
              "type": "boolean",
              "title": "Automatic checking",
              "default": true
            },
            "disabledRules": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "userDictionary": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "ignoreWords": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "ignoredLints": {
              "type": "array",
              "items": { "type": "string" },
              "default": []
            },
            "isolateEnglish": {
              "type": "boolean",
              "default": false
            },
            "ignoreLinkTitle": {
              "type": "boolean",
              "default": false
            },
            "maxFileLength": {
              "type": "integer",
              "default": 120000
            },
            "numSuggestions": {
              "type": "integer",
              "default": 8
            },
            "checkFrontmatter": {
              "type": "boolean",
              "default": false
            },
            "enabledFileTypes": {
              "type": "array",
              "items": { "type": "string" },
              "default": ["markdown", "plaintext"]
            }
          }
        }
      ],
      "services": [
        {
          "id": "spellcheck",
          "service": "language-service",
          "languages": ["markdown", "plaintext"],
          "priority": 90,
          "capabilities": {
            "diagnostics": true,
            "codeActions": true
          }
        }
      ]
    }
  }
}
