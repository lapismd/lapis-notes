{
  "name": "@lapis-notes/bases",
  "private": true,
  "version": "0.0.1",
  "description": "Lapis Notes Bases plugin",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm --dir ../../.. check:no-tailwind packages/plugins/plugin-bases/src && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": ["**/*.css"],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/lang-sql": "^6.9.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/helpers": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@lapis-notes/api": "workspace:*",
    "@lapismd/design-core": "^0.1.0",
    "@lucide/svelte": "^0.523.0",
    "@tanstack/table-core": "^8.21.3",
    "js-yaml": "^4.1.0",
    "lodash-es": "^4.17.21",
    "luxon": "^3.7.1",
    "peaql": "^0.1.25"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
