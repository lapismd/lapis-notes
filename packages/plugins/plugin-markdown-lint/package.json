{
  "name": "@lapis-notes/markdown-lint",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "svelte-package --input src --output dist --tsconfig tsconfig.json",
    "check": "pnpm check:types",
    "check:types": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@lapis-notes/api": "workspace:*",
    "@lapis-notes/language-service": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
