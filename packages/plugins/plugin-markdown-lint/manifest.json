{
  "id": "lapis-markdown-lint",
  "name": "Markdown Lint",
  "version": "2026.6.7",
  "minAppVersion": "1.7.7",
  "description": "Markdown diagnostics provider",
  "author": "Lapis Notes",
  "authorUrl": "https://app.lapis.md",
  "isDesktopOnly": false,
  "lapis": {
    "manifestVersion": 1,
    "source": "official",
    "locked": false,
    "enabledByDefault": true,
    "runtime": {
      "entries": {
        "workspace": {
          "path": "main.mjs",
          "format": "esm",
          "sharedDependencies": [
            "@lapis-notes/api",
            "@lapis-notes/api/language-service",
            "svelte",
            "clsx"
          ],
          "requiresReloadOnUpdate": false
        }
      }
    },
    "contributes": {
      "configuration": [
        {
          "id": "markdown-lint",
          "title": "Markdown Lint",
          "properties": {
            "disabledRules": {
              "type": "array",
              "title": "Disabled rules",
              "description": "Markdownlint rule IDs to suppress for this vault. MD013/line-length starts off.",
              "items": {
                "type": "string"
              },
              "default": ["MD013"]
            },
            "includeGlobs": {
              "type": "array",
              "title": "Include globs",
              "description": "Optional path allowlist for open Markdown documents. Leave empty to lint remaining Markdown after excludes.",
              "items": {
                "type": "string"
              },
              "default": [
                "**/*.{md,markdown,mdown,mkd,mdwn,mdtxt,mdtext}"
              ]
            },
            "excludeGlobs": {
              "type": "array",
              "title": "Exclude globs",
              "description": "Skip matching open Markdown paths.",
              "items": {
                "type": "string"
              },
              "default": [
                "**/node_modules/**",
                "**/bower_components/**",
                "**/.git/**",
                "**/vendor/**",
                "**/.obsidian/**",
                "**/.lapis/**",
                "**/.jj/**"
              ]
            }
          }
        }
      ],
      "services": [
        {
          "id": "markdown-lint",
          "service": "language-service",
          "languages": ["markdown"],
          "priority": 100,
          "capabilities": {
            "diagnostics": true,
            "codeActions": true
          }
        }
      ]
    }
  }
}
