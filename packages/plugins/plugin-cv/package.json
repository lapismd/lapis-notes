{
  "name": "@lapis-notes/cv",
  "private": true,
  "version": "0.0.1",
  "description": "Lapis Notes CV YAML views and browser preview",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm --dir ../../.. check:no-tailwind packages/plugins/plugin-cv/src && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:storybook": "vitest run --project storybook",
    "build-storybook": "NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" storybook build --config-dir .storybook --output-dir storybook-static",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint",
    "storybook": "STORYBOOK_PORT=7020 storybook dev -p 7020 --no-open --config-dir .storybook",
    "storybook:stop": "STORYBOOK_PORT=7020 node ../../../scripts/with-storybook-env.mjs bash ../../../scripts/storybook-stop.sh"
  },
  "files": [
    "dist",
    "static",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.stories.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#cv-assets/*": "./static/*"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@lapis-notes/api": "workspace:*",
    "@lapismd/design-core": "*",
    "@lapismd/mira": "*",
    "@lucide/svelte": "^0.523.0",
    "@myriaddreamin/typst-ts-renderer": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.11.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/source-code-pro": "^5.2.7",
    "@lapis-notes/file-explorer": "workspace:*",
    "@lapis-notes/markdown": "workspace:*",
    "@lapis-notes/search": "workspace:*",
    "@lapis-notes/workspace": "workspace:*",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/svelte-vite": "^10.5.7",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.1.12",
    "@tsconfig/svelte": "^5.0.5",
    "publint": "^0.3.12",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.1.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "@vitest/browser-playwright": "^4.1.8",
    "vitest": "^4.1.8"
  }
}
