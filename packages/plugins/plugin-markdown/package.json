{
  "name": "@lapis-notes/markdown",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm --dir ../../.. check:no-tailwind packages/plugins/plugin-markdown/src && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "node -e \"process.exit(0)\"",
    "test": "vitest run --passWithNoTests",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": ["**/*.css"],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@lapis-notes/api": "workspace:*",
    "@lapis-notes/ui": "workspace:*",
    "@lapismd/design-core": "*",
    "@lapismd/mira": "*",
    "@lapismd/mira-editor": "*",
    "@lapismd/mira-plugin-ai": "*",
    "@lapismd/mira-plugin-mermaid": "*",
    "@lucide/svelte": "^0.523.0"
  },
  "peerDependencies": {
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.35.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
