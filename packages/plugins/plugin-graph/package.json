{
  "name": "@lapis-notes/graph",
  "private": true,
  "version": "0.0.1",
  "description": "Lapis Notes global and local graph plugin",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm --dir ../../.. check:no-tailwind packages/plugins/plugin-graph/src && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && publint"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "svelte": "./dist/embed.js",
      "import": "./dist/embed.js",
      "default": "./dist/embed.js"
    },
    "./app.css": {
      "default": "./dist/styles.css"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    }
  },
  "dependencies": {
    "@lapis-notes/api": "workspace:*",
    "@lapis-notes/markdown": "workspace:*",
    "@lapismd/design-core": "*",
    "@lucide/svelte": "^0.523.0",
    "d3-force": "^3.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/d3-force": "^3.0.10",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
}
