{
  "name": "@lapis-notes/ui",
  "private": true,
  "version": "0.0.1",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "pnpm run prepack",
    "check": "pnpm --dir ../.. check:no-tailwind packages/ui/src/lib/components && pnpm check:svelte && pnpm check:types",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings --output human",
    "check:types": "tsc -p tsconfig.node.json --noEmit",
    "dev": "pnpm --dir ../.. storybook",
    "storybook": "pnpm --dir ../.. storybook",
    "test": "vitest run",
    "prepack": "svelte-package --tsconfig ./tsconfig.pack.json && cp src/lib/theme.css dist/theme.css && cp src/lib/styles.css dist/styles.css && cp src/lib/codemirror-autocomplete.css dist/codemirror-autocomplete.css && publint"
  },
  "files": [
    "dist",
    "src/lib/internal",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": {
      "default": "./dist/theme.css"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./codemirror-autocomplete.css": {
      "default": "./dist/codemirror-autocomplete.css"
    },
    "./table-dnd/utils": {
      "types": "./dist/components/ui/table-dnd/table-dnd-utils.d.ts",
      "import": "./dist/components/ui/table-dnd/table-dnd-utils.js",
      "default": "./dist/components/ui/table-dnd/table-dnd-utils.js"
    },
    "./table-dnd/sensors": {
      "types": "./dist/components/ui/table-dnd/table-dnd-sensors.d.ts",
      "import": "./dist/components/ui/table-dnd/table-dnd-sensors.js",
      "default": "./dist/components/ui/table-dnd/table-dnd-sensors.js"
    },
    "./*": {
      "types": "./dist/components/ui/*/index.d.ts",
      "svelte": "./dist/components/ui/*/index.js",
      "import": "./dist/components/ui/*/index.js",
      "default": "./dist/components/ui/*/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@lapismd/design-core": "*"
  },
  "devDependencies": {
    "@internationalized/date": "^3.8.2",
    "@lucide/svelte": "^0.515.0",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/table-core": "^8.21.3",
    "@tsconfig/svelte": "^5.0.5",
    "bits-ui": "2.18.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "publint": "^0.3.12",
    "svelte": "^5.38.2",
    "svelte-check": "^4.3.1",
    "svelte-sonner": "^1.0.5",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.12",
    "tw-animate-css": "^1.3.7",
    "typescript": "~5.8.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@lapismd/design-core": "*",
    "fuse.js": "^7.3.0"
  }
}
