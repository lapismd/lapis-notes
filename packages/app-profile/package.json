{
  "name": "@lapis-notes/app-profile",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./plugin-host-build": {
      "types": "./dist/plugin-host-build.d.ts",
      "svelte": "./dist/plugin-host-build.js",
      "import": "./dist/plugin-host-build.js",
      "default": "./dist/plugin-host-build.js"
    },
    "./native-chat": {
      "types": "./dist/native-chat/index.d.ts",
      "svelte": "./dist/native-chat/index.js",
      "import": "./dist/native-chat/index.js",
      "default": "./dist/native-chat/index.js"
    },
    "./native-repository": {
      "types": "./dist/native-repository.d.ts",
      "svelte": "./dist/native-repository.js",
      "import": "./dist/native-repository.js",
      "default": "./dist/native-repository.js"
    },
    "./workspace-session": {
      "types": "./dist/workspace-session/index.d.ts",
      "svelte": "./dist/workspace-session/index.js",
      "import": "./dist/workspace-session/index.js",
      "default": "./dist/workspace-session/index.js"
    }
  },
  "scripts": {
    "build": "pnpm check && svelte-package --input src --output dist --tsconfig tsconfig.pack.json",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "test": "vitest run",
    "prepack": "pnpm build && publint"
  },
  "dependencies": {
    "@lapis-notes/api": "^0.2.4",
    "@lapis-notes/file-explorer": "^0.2.1",
    "@lapis-notes/markdown": "^0.2.1",
    "@lapis-notes/search": "^0.1.4",
    "@lapis-notes/source-editor": "^0.1.3",
    "@lapis-notes/workspace": "^0.3.2",
    "@lapismd/agent-ui": "^0.2.0",
    "@lapismd/design-core": "^0.9.0",
    "@lapis-notes/history": "^0.2.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.5",
    "publint": "^0.3.12",
    "svelte": "5.56.10",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "@types/node": "^24.0.0"
  },
  "license": "Apache-2.0",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md",
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.fixture.*"
  ],
  "peerDependencies": {
    "svelte": "^5.56.10",
    "vite": "^6.4.5 || ^7.3.6"
  },
  "description": "Shared Lapis Notes application profile and workspace session",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lapismd/lapis-notes.git",
    "directory": "packages/app-profile"
  },
  "homepage": "https://github.com/lapismd/lapis-notes/tree/main/packages/app-profile#readme",
  "bugs": {
    "url": "https://github.com/lapismd/lapis-notes/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
