{
  "name": "@lapis-notes/app-profile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plugin-host-build": "./src/plugin-host-build.ts",
    "./native-chat": {
      "types": "./dist/native-chat/index.d.ts",
      "svelte": "./dist/native-chat/index.js",
      "import": "./dist/native-chat/index.js"
    },
    "./native-repository": "./src/native-repository.ts"
  },
  "scripts": {
    "build": "pnpm build:native-chat && pnpm check",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "test": "vitest run",
    "build:native-chat": "svelte-package --input src/native-chat --output dist/native-chat --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@lapis-notes/api": "workspace:*",
    "@lapis-notes/file-explorer": "workspace:*",
    "@lapis-notes/markdown": "^0.1.6",
    "@lapis-notes/search": "^0.1.3",
    "@lapis-notes/source-editor": "^0.1.2",
    "@lapis-notes/workspace": "workspace:*",
    "@lapismd/agent-ui": "^0.1.0",
    "@lapismd/design-core": "^0.7.0",
    "@lapis-notes/history": "^0.1.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.5",
    "svelte": "5.56.10",
    "svelte-check": "^4.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "@sveltejs/package": "^2.5.8"
  },
  "license": "Apache-2.0",
  "files": [
    "src",
    "dist",
    "!**/*.test.*"
  ],
  "peerDependencies": {
    "svelte": "^5.56.10"
  }
}
