{
  "$defs": {
    "AttachClient": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["protocol_version"],
      "type": "object"
    },
    "ChangeDomain": {
      "enum": [
        "metadata",
        "search",
        "history",
        "notification",
        "notebook",
        "task",
        "projection",
        "memory",
        "meta"
      ],
      "type": "string"
    },
    "ChangeSet": {
      "additionalProperties": false,
      "properties": {
        "committedAt": { "format": "int64", "type": "integer" },
        "domains": {
          "items": { "$ref": "#/$defs/ChangeDomain" },
          "type": "array"
        },
        "paths": { "items": { "type": "string" }, "type": "array" },
        "renamed": {
          "items": { "$ref": "#/$defs/ChangedPath" },
          "type": ["array", "null"]
        },
        "reset": { "type": ["boolean", "null"] },
        "revision": { "format": "uint64", "minimum": 0, "type": "integer" }
      },
      "required": ["revision", "domains", "paths", "committedAt"],
      "type": "object"
    },
    "ChangedPath": {
      "additionalProperties": false,
      "properties": {
        "newPath": { "type": "string" },
        "oldPath": { "type": "string" }
      },
      "required": ["oldPath", "newPath"],
      "type": "object"
    },
    "ClientDescriptor": {
      "additionalProperties": false,
      "properties": {
        "client_id": { "format": "uuid", "type": "string" },
        "generation": { "format": "uuid", "type": "string" },
        "vault_id": { "format": "uuid", "type": "string" }
      },
      "required": ["client_id", "vault_id", "generation"],
      "type": "object"
    },
    "EditorClaim": {
      "additionalProperties": false,
      "properties": {
        "detached": { "type": "boolean" },
        "editor_id": { "format": "uuid", "type": "string" },
        "path": { "type": "string" },
        "revision": { "format": "uint32", "minimum": 0, "type": "integer" }
      },
      "required": ["editor_id", "path", "revision", "detached"],
      "type": "object"
    },
    "EntryStat": {
      "additionalProperties": false,
      "properties": {
        "ctime": { "format": "double", "type": "number" },
        "mtime": { "format": "double", "type": "number" },
        "size": { "format": "uint64", "minimum": 0, "type": "integer" },
        "type": { "type": "string" }
      },
      "required": ["type", "size", "ctime", "mtime"],
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "INVALID_REQUEST",
        "PROTOCOL_MISMATCH",
        "PERMISSION_DENIED",
        "NOT_FOUND",
        "CONFLICT",
        "ALREADY_EXISTS",
        "DIRECTORY_NOT_EMPTY",
        "IS_DIRECTORY",
        "NOT_DIRECTORY",
        "UNSUPPORTED",
        "BUSY",
        "CLOSED",
        "IO"
      ],
      "type": "string"
    },
    "ExpectedVersion": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "missing", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "version", "type": "string" },
            "version": { "type": "string" }
          },
          "required": ["kind", "version"],
          "type": "object"
        }
      ]
    },
    "FileCommand": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "operation": { "const": "create-file", "type": "string" },
            "options": {
              "$ref": "#/$defs/FileOptions",
              "default": { "mtime": null }
            },
            "path": { "type": "string" }
          },
          "required": ["operation", "path", "data"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "newPath": { "type": "string" },
            "operation": { "const": "rename", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path", "newPath"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "newPath": { "type": "string" },
            "operation": { "const": "copy", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path", "newPath"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "remove", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "rmdir", "type": "string" },
            "path": { "type": "string" },
            "recursive": { "default": false, "type": "boolean" }
          },
          "required": ["operation", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "stat", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "exists", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "list", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "read-text", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "read-binary", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "length": { "format": "uint", "minimum": 0, "type": "integer" },
            "offset": { "format": "uint64", "minimum": 0, "type": "integer" },
            "operation": { "const": "read-range", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["operation", "path", "offset", "length"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": { "type": "string" },
            "operation": { "const": "write-text", "type": "string" },
            "options": {
              "$ref": "#/$defs/FileOptions",
              "default": { "mtime": null }
            },
            "path": { "type": "string" }
          },
          "required": ["operation", "path", "data"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": { "type": "string" },
            "expected": { "type": ["string", "null"] },
            "operation": {
              "const": "write-text-if-unchanged",
              "type": "string"
            },
            "options": {
              "$ref": "#/$defs/FileOptions",
              "default": { "mtime": null }
            },
            "path": { "type": "string" }
          },
          "required": ["operation", "path", "data"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "operation": { "const": "write-binary", "type": "string" },
            "options": {
              "$ref": "#/$defs/FileOptions",
              "default": { "mtime": null }
            },
            "path": { "type": "string" }
          },
          "required": ["operation", "path", "data"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": { "type": "string" },
            "operation": { "const": "append-text", "type": "string" },
            "options": {
              "$ref": "#/$defs/FileOptions",
              "default": { "mtime": null }
            },
            "path": { "type": "string" }
          },
          "required": ["operation", "path", "data"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": { "const": "mkdir", "type": "string" },
            "path": { "type": "string" },
            "recursive": { "default": false, "type": "boolean" }
          },
          "required": ["operation", "path"],
          "type": "object"
        }
      ]
    },
    "FileHistory": {
      "additionalProperties": false,
      "properties": {
        "file": { "$ref": "#/$defs/HistoryFile" },
        "revisions": {
          "items": { "$ref": "#/$defs/HistoryRevision" },
          "type": "array"
        }
      },
      "required": ["file", "revisions"],
      "type": "object"
    },
    "FileListing": {
      "additionalProperties": false,
      "properties": {
        "files": { "items": { "type": "string" }, "type": "array" },
        "folders": { "items": { "type": "string" }, "type": "array" }
      },
      "required": ["files", "folders"],
      "type": "object"
    },
    "FileOptions": {
      "additionalProperties": false,
      "properties": {
        "mtime": { "format": "double", "type": ["number", "null"] }
      },
      "type": "object"
    },
    "FileValue": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "data": { "type": "string" },
            "kind": { "const": "text", "type": "string" }
          },
          "required": ["kind", "data"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": { "const": "binary", "type": "string" }
          },
          "required": ["kind", "data"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "stat", "type": "string" },
            "stat": {
              "anyOf": [{ "$ref": "#/$defs/EntryStat" }, { "type": "null" }]
            }
          },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exists": { "type": "boolean" },
            "kind": { "const": "exists", "type": "string" }
          },
          "required": ["kind", "exists"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "list", "type": "string" },
            "listing": { "$ref": "#/$defs/FileListing" }
          },
          "required": ["kind", "listing"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "done", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        }
      ]
    },
    "HistoryEvent": {
      "enum": ["baseline", "create", "modify", "rename", "delete", "restore"],
      "type": "string"
    },
    "HistoryFile": {
      "additionalProperties": false,
      "properties": {
        "currentPath": { "type": "string" },
        "deleted": { "type": "boolean" },
        "fileId": { "type": "string" }
      },
      "required": ["fileId", "currentPath", "deleted"],
      "type": "object"
    },
    "HistoryRevision": {
      "additionalProperties": false,
      "properties": {
        "capturedPath": { "type": "string" },
        "content": { "type": "string" },
        "contentHash": { "type": "string" },
        "createdAt": { "format": "double", "type": "number" },
        "currentPath": { "type": "string" },
        "eventType": { "$ref": "#/$defs/HistoryEvent" },
        "fileId": { "type": "string" },
        "revisionId": { "type": "string" },
        "sourceMtime": { "format": "double", "type": ["number", "null"] },
        "sourceSize": { "format": "double", "type": ["number", "null"] }
      },
      "required": [
        "revisionId",
        "fileId",
        "currentPath",
        "capturedPath",
        "eventType",
        "createdAt",
        "contentHash",
        "content"
      ],
      "type": "object"
    },
    "HostInfo": {
      "additionalProperties": false,
      "properties": {
        "browser_auth": { "type": "boolean" },
        "build_id": { "type": "string" },
        "protocol_major": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["protocol_major", "build_id", "browser_auth"],
      "type": "object"
    },
    "LoginRequest": {
      "additionalProperties": false,
      "properties": {
        "password": { "type": "string" },
        "username": { "type": "string" }
      },
      "required": ["username", "password"],
      "type": "object"
    },
    "LogoutReply": {
      "additionalProperties": false,
      "properties": { "ok": { "type": "boolean" } },
      "required": ["ok"],
      "type": "object"
    },
    "ManagedVault": {
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "vault_id": { "format": "uuid", "type": "string" }
      },
      "required": ["vault_id", "name"],
      "type": "object"
    },
    "MetaCheck": {
      "additionalProperties": false,
      "properties": {
        "exists": { "type": ["boolean", "null"] },
        "key": { "type": "string" },
        "value": true
      },
      "required": ["key"],
      "type": "object"
    },
    "MetaEntry": {
      "additionalProperties": false,
      "properties": { "key": { "type": "string" }, "value": true },
      "required": ["key", "value"],
      "type": "object"
    },
    "MetaMutation": {
      "additionalProperties": false,
      "properties": {
        "delete": { "default": false, "type": "boolean" },
        "key": { "type": "string" },
        "value": true
      },
      "required": ["key"],
      "type": "object"
    },
    "MetaPage": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": { "$ref": "#/$defs/MetaEntry" },
          "type": "array"
        },
        "nextCursor": { "type": ["string", "null"] }
      },
      "required": ["entries"],
      "type": "object"
    },
    "MetaScan": {
      "additionalProperties": false,
      "properties": {
        "after": { "default": null, "type": ["string", "null"] },
        "limit": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "prefix": { "type": "string" }
      },
      "required": ["prefix"],
      "type": "object"
    },
    "MetaTransaction": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "default": [],
          "items": { "$ref": "#/$defs/MetaCheck" },
          "type": "array"
        },
        "mutations": {
          "items": { "$ref": "#/$defs/MetaMutation" },
          "type": "array"
        }
      },
      "required": ["mutations"],
      "type": "object"
    },
    "MetadataSnapshot": {
      "additionalProperties": false,
      "properties": {
        "fileCache": {
          "additionalProperties": { "$ref": "#/$defs/SnapshotFile" },
          "type": "object"
        },
        "metadataCache": { "additionalProperties": true, "type": "object" },
        "resolvedLinks": {
          "additionalProperties": {
            "additionalProperties": { "format": "double", "type": "number" },
            "type": "object"
          },
          "type": "object"
        },
        "unresolvedLinks": {
          "additionalProperties": {
            "additionalProperties": { "format": "double", "type": "number" },
            "type": "object"
          },
          "type": "object"
        }
      },
      "required": [
        "fileCache",
        "metadataCache",
        "resolvedLinks",
        "unresolvedLinks"
      ],
      "type": "object"
    },
    "NotebookCell": {
      "additionalProperties": false,
      "properties": {
        "durationMs": { "format": "double", "type": ["number", "null"] },
        "error": { "type": ["string", "null"] },
        "inputValues": {
          "additionalProperties": true,
          "type": ["object", "null"]
        },
        "outputs": { "items": true, "type": "array" },
        "setupPhases": {
          "items": { "$ref": "#/$defs/NotebookPhase" },
          "type": ["array", "null"]
        },
        "sourceHash": { "type": ["string", "null"] },
        "state": { "type": "string" }
      },
      "required": ["state", "outputs"],
      "type": "object"
    },
    "NotebookPhase": {
      "additionalProperties": false,
      "properties": {
        "detail": { "type": ["string", "null"] },
        "durationMs": { "format": "double", "type": ["number", "null"] },
        "key": { "type": "string" },
        "label": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["key", "label", "status"],
      "type": "object"
    },
    "NotebookState": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "additionalProperties": { "$ref": "#/$defs/NotebookCell" },
          "type": "object"
        },
        "mtime": { "format": "double", "type": "number" },
        "sourcePath": { "type": "string" },
        "updatedAt": { "format": "double", "type": "number" }
      },
      "required": ["sourcePath", "mtime", "updatedAt", "cells"],
      "type": "object"
    },
    "NotificationRecord": {
      "additionalProperties": false,
      "properties": {
        "cleared": { "type": "boolean" },
        "createdAt": { "format": "double", "type": "number" },
        "id": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "severity": { "$ref": "#/$defs/NotificationSeverity" },
        "source": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "updatedAt": { "format": "double", "type": "number" }
      },
      "required": [
        "id",
        "message",
        "severity",
        "createdAt",
        "updatedAt",
        "read",
        "cleared"
      ],
      "type": "object"
    },
    "NotificationSeverity": {
      "enum": ["info", "warning", "error"],
      "type": "string"
    },
    "Outcome": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": { "const": "ok", "type": "string" },
            "value": { "$ref": "#/$defs/VaultValue" }
          },
          "required": ["status", "value"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": { "$ref": "#/$defs/ServiceError" },
            "status": { "const": "error", "type": "string" }
          },
          "required": ["status", "error"],
          "type": "object"
        }
      ]
    },
    "Reply": {
      "additionalProperties": false,
      "properties": {
        "outcome": { "$ref": "#/$defs/Outcome" },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "request_id": { "format": "uuid", "type": "string" }
      },
      "required": ["protocol_version", "request_id", "outcome"],
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "command": { "$ref": "#/$defs/VaultCommand" },
        "generation": { "format": "uuid", "type": "string" },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "request_id": { "format": "uuid", "type": "string" },
        "vault_id": { "format": "uuid", "type": "string" }
      },
      "required": [
        "protocol_version",
        "request_id",
        "vault_id",
        "generation",
        "command"
      ],
      "type": "object"
    },
    "ServiceError": {
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "type": "object"
    },
    "SessionInfo": {
      "additionalProperties": false,
      "properties": {
        "csrf_token": { "type": "string" },
        "expires_at": { "format": "int64", "type": "integer" },
        "username": { "type": "string" }
      },
      "required": ["username", "csrf_token", "expires_at"],
      "type": "object"
    },
    "SnapshotFile": {
      "additionalProperties": false,
      "properties": {
        "hash": { "type": "string" },
        "mtime": { "format": "double", "type": "number" },
        "size": { "format": "double", "type": "number" }
      },
      "required": ["mtime", "size", "hash"],
      "type": "object"
    },
    "StoreHistory": {
      "additionalProperties": false,
      "properties": {
        "content": { "type": ["string", "null"] },
        "contentHash": { "type": ["string", "null"] },
        "createdAt": { "format": "double", "type": "number" },
        "eventType": { "$ref": "#/$defs/HistoryEvent" },
        "maxRevisions": { "format": "double", "type": ["number", "null"] },
        "path": { "type": "string" },
        "previousPath": { "type": ["string", "null"] },
        "replaceLatest": { "default": false, "type": "boolean" },
        "sourceMtime": { "format": "double", "type": ["number", "null"] },
        "sourceSize": { "format": "double", "type": ["number", "null"] }
      },
      "required": ["path", "eventType", "createdAt"],
      "type": "object"
    },
    "StoredHistory": {
      "additionalProperties": false,
      "properties": {
        "deduplicated": { "type": "boolean" },
        "fileId": { "type": "string" },
        "revision": {
          "anyOf": [{ "$ref": "#/$defs/HistoryRevision" }, { "type": "null" }]
        },
        "stored": { "type": "boolean" }
      },
      "required": ["fileId", "stored", "deduplicated"],
      "type": "object"
    },
    "TextSnapshot": {
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "text": { "type": "string" },
        "version": { "type": "string" }
      },
      "required": ["path", "text", "version"],
      "type": "object"
    },
    "VaultCommand": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "files", "type": "string" },
            "operation": { "$ref": "#/$defs/FileCommand" }
          },
          "required": ["kind", "operation"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "read_text", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["kind", "path"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expected": { "$ref": "#/$defs/ExpectedVersion" },
            "kind": { "const": "write_text", "type": "string" },
            "path": { "type": "string" },
