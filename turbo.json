{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true,
    "timeout": 10,
    "uploadTimeout": 30
  },
  "futureFlags": {
    "longerSignatureKey": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "outputLogs": "new-only"
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "check:types": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "check:svelte": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "envMode": "loose"
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "outputLogs": "new-only"
    },
    "//#ci:storybook-static": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/*/src/**",
        "packages/*/scripts/**",
        "packages/*/package.json",
        "packages/*/tsconfig*.json",
        "packages/*/svelte.config.*",
        "packages/*/vite.config.*",
        ".github/actions/ci-setup/action.yml",
        ".ci/images.json",
        ".ci/dependency-image.Dockerfile",
        "!**/.DS_Store",
        ".pnpmfile.cjs",
        ".local-plugin-install.json"
      ],
      "env": [
        "CI",
        "LAPIS_TURBO_TOOLCHAIN",
        "NODE_OPTIONS",
        "PLAYWRIGHT_BROWSERS_PATH",
        "STORYBOOK_PORT",
        "VISUAL_SERVER_PORT",
        "STORYBOOK_EXTRA_PORTS",
        "SPECIFICATION_PORT",
        "SPECIFICATION_BASE_URL",
        "WORKSPACE_STORYBOOK_PORT",
        "WORKSPACE_VISUAL_SERVER_PORT",
        "WATCHPACK_POLLING"
      ],
      "outputs": ["storybook-static/**", ".visual-delta/cache/**"],
      "outputLogs": "new-only"
    },
    "//#ci:storybook-interaction": {
