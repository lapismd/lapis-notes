{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true,
    "timeout": 10,
    "uploadTimeout": 30
  },
  "futureFlags": {
    "longerSignatureKey": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "check:svelte": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#ci:storybook-static": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/*/src/**",
        "packages/*/scripts/**",
        "packages/*/package.json",
        "packages/*/tsconfig*.json",
        "packages/*/svelte.config.*",
        "packages/*/vite.config.*",
        ".github/actions/ci-setup/action.yml",
        ".ci/images.json",
        ".ci/dependency-image.Dockerfile",
        "!**/.DS_Store"
      ],
      "env": [
        "CI",
        "LAPIS_TURBO_TOOLCHAIN",
        "NODE_OPTIONS",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "outputs": ["storybook-static/**", ".visual-delta/cache/**"]
    },
    "//#ci:storybook-interaction": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "packages/*/src/**",
        "packages/*/scripts/**",
        "packages/*/package.json",
        "packages/*/tsconfig*.json",
        "packages/*/svelte.config.*",
        "packages/*/vite.config.*",
        ".github/actions/ci-setup/action.yml",
        ".ci/images.json",
        ".ci/dependency-image.Dockerfile",
        "!**/.DS_Store"
      ],
      "env": [
        "CI",
        "LAPIS_TURBO_TOOLCHAIN",
        "NODE_OPTIONS",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "outputs": []
    },
    "@lapis-notes/api#build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "src/lib/generated/plugin-host-modules.schema.generated.ts"
      ]
    }
  }
}
