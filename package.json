{
  "name": "lapis-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "node --env-file-if-exists=.env scripts/run-turbo.mjs build",
    "build:desktop": "node --env-file-if-exists=.env scripts/run-turbo.mjs build --filter=@lapis-notes/desktop-deno...",
    "build:web": "node --env-file-if-exists=.env scripts/run-turbo.mjs build --filter=@lapis-notes/web...",
    "changeset": "changeset",
    "check": "pnpm spec:validate && pnpm check:specification-docs && pnpm check:no-tailwind && pnpm check:app-ownership && pnpm check:metadata-queries && node --env-file-if-exists=.env scripts/run-turbo.mjs check",
    "check:all": "pnpm check && pnpm test && pnpm build",
    "check:app-ownership": "tsx scripts/check-ambient-app-ownership.ts",
    "check:metadata-queries": "tsx scripts/check-first-party-metadata-queries.ts",
    "check:no-tailwind": "tsx scripts/check-no-tailwind-utilities.ts",
    "check:svelte": "node --env-file-if-exists=.env scripts/run-turbo.mjs check:svelte",
    "check:types": "node --env-file-if-exists=.env scripts/run-turbo.mjs check:types",
    "terminal-host": "pnpm exec lapis-terminal-host",
    "ai:smoke:seed": "tsx scripts/ai-real-host.ts seed",
    "ai:smoke:storybook": "pnpm plugins:local:install && tsx scripts/ai-real-host.ts storybook",
    "ai:smoke:desktop": "pnpm plugins:local:install && tsx scripts/ai-real-host.ts desktop",
    "ai:smoke:probe:codex-acp": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts codex-acp",
    "ai:smoke:probe:cursor-acp": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts cursor-acp",
    "ai:smoke:probe:codex-native": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts codex-native",
    "ai:smoke:probe:handoff": "pnpm plugins:local:install && tsx scripts/ai-cross-agent-handoff-probe.ts",
    "test:ai:smoke-harness": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:ai:smoke-harness:run --task-args",
    "dev": "pnpm storybook",
    "plugins:local:install": "node scripts/prepare-local-plugin-consumer.mjs",
    "dev:desktop": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/desktop-deno dev",
    "dev:desktop:cef": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && LAPIS_DENO_BACKEND=cef pnpm --filter @lapis-notes/desktop-deno dev",
    "dev:desktop:chrome": "pnpm dev:desktop:cef",
    "dev:desktop:telemetry": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/desktop-deno dev:telemetry",
    "dev:desktop:telemetry:cef": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/desktop-deno dev:telemetry:cef",
    "telemetry:lgtm": "pnpm --filter @lapis-notes/desktop-deno telemetry:lgtm",
    "dev:web": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/web dev",
    "restart:web": "bash scripts/web-restart.sh",
    "storybook": "pnpm plugins:local:install && WATCHPACK_POLLING=250 node scripts/with-storybook-env.mjs node scripts/storybook-run.mjs --no-open",
    "storybook:stop": "node scripts/with-storybook-env.mjs bash scripts/storybook-stop.sh",
    "storybook:restart": "node scripts/with-storybook-env.mjs bash scripts/storybook-restart.sh",
    "build-storybook": "node --env-file-if-exists=.env scripts/run-turbo.mjs build-storybook:run --task-args",
    "check:storybook-index": "node scripts/spec-validation/storybook-spec-index.mjs",
    "test:storybook": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:storybook:run --task-args",
    "test:workspace:pointer": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:workspace:pointer:run --task-args",
    "test:visual": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:visual:run --task-args",
    "test:visual:update": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:visual:update:run --task-args",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check && pnpm check:app-ownership && pnpm check:metadata-queries && pnpm test:spec-validation",
    "spec:first": "spec-validator first",
    "spec:index": "spec-validator index",
    "spec:search": "spec-validator search",
    "spec:validate": "spec-validator validate",
    "test:spec-validation": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:spec-validation:run --task-args",
    "spec:serve": "spec-validator serve",
    "test": "node --env-file-if-exists=.env scripts/run-turbo.mjs test",
    "packages:policy": "node ./scripts/check-package-boundaries.mjs && pnpm test:package-boundaries",
    "packages:check": "pnpm packages:policy && pnpm test:local-plugin-consumer && pnpm release:check && pnpm release:test",
    "packages:pack": "node --env-file-if-exists=.env scripts/pack-packages.mjs",
    "ci:packages": "node --env-file-if-exists=.env scripts/run-turbo.mjs build check test",
    "ci:release": "pnpm packages:check && pnpm spec:check && pnpm check:no-tailwind && pnpm ci:packages && pnpm packages:pack -- --already-built && node scripts/run-turbo.mjs ci:storybook-static --summarize && node scripts/run-turbo.mjs ci:storybook-interaction --summarize",
    "ci:container": "node --env-file-if-exists=.env scripts/run-ci-container.mjs",
    "release:check": "node ./scripts/check-release-config.mjs && node ./scripts/check-release-workflow.mjs && pnpm desktop:release:check",
    "release:intent": "node ./scripts/check-release-intent.mjs",
    "release:notes": "node ./scripts/create-github-releases.mjs",
    "release:plan": "node ./scripts/release-plan.mjs",
    "release:prepare": "node ./scripts/prepare-release.mjs",
    "release:publish": "node ./scripts/publish-release.mjs",
    "release:test": "node --env-file-if-exists=.env scripts/run-turbo.mjs release:test:run --task-args",
    "release:verify": "node ./scripts/verify-release.mjs",
    "release:version": "pnpm release:check && changeset version && pnpm install --lockfile-only && pnpm release:check",
    "package:desktop": "pnpm --filter @lapis-notes/desktop-deno package:app",
    "test:desktop:packaged": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:desktop:packaged:run --task-args",
    "test:local-plugin-consumer": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:local-plugin-consumer:run --task-args",
    "dist:desktop:mac:arm64": "pnpm --filter @lapis-notes/desktop-deno package:macos:arm64",
    "dist:desktop:mac:x64": "pnpm --filter @lapis-notes/desktop-deno package:macos:x64",
    "dist:desktop:linux:arm64": "pnpm --filter @lapis-notes/desktop-deno package:linux:arm64",
    "dist:desktop:linux:x64": "pnpm --filter @lapis-notes/desktop-deno package:linux:x64",
    "preview:web": "pnpm --filter @lapis-notes/web preview",
    "test:web:e2e": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:web:e2e:run --task-args",
    "performance:metadata:native": "pnpm --filter @lapis-notes/api performance:metadata:native",
    "performance:metadata:wasm": "tsx scripts/metadata-performance-wasm.ts",
    "performance:metadata:stress:native": "pnpm --filter @lapis-notes/api performance:metadata:native -- --notes 100000 --runs 1 --no-enforce",
    "performance:metadata:stress:wasm": "tsx scripts/metadata-performance-wasm.ts --notes 100000 --runs 1 --no-enforce",
    "ai-controller": "lapis-ai-controller",
    "ci:storybook-static": "pnpm build-storybook:run && pnpm test:specification:static:run",
    "ci:storybook-interaction": "pnpm test:storybook:run && pnpm test:specification:dev:run",
    "check:specification-docs": "tsc -p tsconfig.specification-docs.json && node scripts/spec-validation/sync-specification.mjs",
    "test:specification:dev": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:specification:dev:run --task-args",
    "test:specification:static": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:specification:static:run --task-args",
    "spec:mirrors": "node scripts/spec-validation/sync-specification.mjs --write",
    "test:ai:smoke-harness:run": "node --test scripts/lib/ai-real-host-fixture.test.mjs scripts/ai-host-storybook-boundary.test.mjs",
    "test:storybook:run": "vitest run --project storybook --shard=1/4 && vitest run --project storybook --shard=2/4 && vitest run --project storybook --shard=3/4 && vitest run --project storybook --shard=4/4",
    "test:workspace:pointer:run": "node scripts/with-storybook-env.mjs playwright test -c playwright.workspace.config.ts",
    "test:visual:run": "node ./scripts/test-visual.mjs",
    "test:visual:update:run": "node ./scripts/update-visual-baselines.mjs",
    "test:spec-validation:run": "node --test scripts/spec-validation/*.test.mjs",
    "release:test:run": "node --test ./scripts/web-registry-acceptance.test.mjs ./scripts/storybook-turbo-cache.test.mjs ./scripts/ci-images.test.mjs ./scripts/dependency-image-pr.test.mjs ./scripts/ci-container.test.mjs ./scripts/check-release-intent.spec.mjs ./scripts/check-release-workflow.spec.mjs ./scripts/create-github-releases.spec.mjs ./scripts/publish-release.spec.mjs ./scripts/release-manifest.spec.mjs ./scripts/verify-release.spec.mjs ./scripts/release-plan.spec.mjs ./scripts/release-changelog.spec.mjs ./scripts/desktop-release.test.mjs ./scripts/desktop-release-workflow.test.mjs ./scripts/dependency-security.spec.mjs",
    "test:desktop:packaged:run": "pnpm --filter @lapis-notes/desktop-deno test:packaged",
    "test:local-plugin-consumer:run": "node --test scripts/local-plugin-pnpmfile.test.mjs scripts/lib/local-plugin-consumer.test.mjs",
    "test:web:e2e:run": "node scripts/run-web-registry-acceptance.mjs",
    "test:specification:dev:run": "playwright test -c playwright.specification.config.ts",
    "test:specification:static:run": "SPECIFICATION_STATIC=1 playwright test -c playwright.specification.config.ts",
    "build-storybook:run": "node -e \"require('node:fs').mkdirSync('.visual-delta/cache',{recursive:true})\" && NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" storybook build --stats-json .visual-delta/cache && pnpm check:storybook-index",
    "test:spec-validation:view-commands": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:spec-validation:view-commands:run --task-args",
    "test:spec-validation:view-commands:run": "node --test scripts/spec-validation/view-command-audit.test.mjs",
    "test:spec-validation:storybook-structure": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:spec-validation:storybook-structure:run --task-args",
    "test:spec-validation:storybook-structure:run": "node --test scripts/spec-validation/storybook-structure-audit.test.mjs",
    "test:package-boundaries": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:package-boundaries:run --task-args",
    "test:package-boundaries:run": "node --test ./scripts/check-package-boundaries.spec.mjs",
    "storybook:installed": "WATCHPACK_POLLING=250 node scripts/with-storybook-env.mjs node scripts/storybook-run.mjs --no-open",
    "desktop:release:check": "node scripts/check-desktop-release-workflow.mjs",
    "desktop:release:test": "node --test scripts/desktop-release.test.mjs scripts/desktop-release-workflow.test.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^3.0.3",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.4.3",
    "@lezer/lr": "^1.4.2",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@fontsource/source-code-pro": "^5.2.7",
    "@lapis-notes/api": "workspace:*",
    "@lapis-notes/ai": "^0.1.5",
    "@lapismd/terminal-host": "^0.1.0",
    "@lapis-notes/bases": "^0.1.3",
    "@lapis-notes/bookmarks": "^0.1.3",
    "@lapis-notes/file-explorer": "workspace:*",
    "@lapis-notes/graph": "^0.1.3",
    "@lapis-notes/markdown": "^0.1.6",
    "@lapis-notes/markdown-lint": "^0.1.2",
    "@lapis-notes/spellcheck": "^0.1.3",
    "@lapis-notes/history": "^0.1.4",
    "@lapis-notes/search": "^0.1.3",
    "@lapis-notes/source-editor": "^0.1.2",
    "@lapis-notes/wordcount": "^0.1.2",
    "@lapis-notes/ui": "workspace:*",
    "@lapis-notes/workspace": "workspace:*",
    "@lapismd/design-core": "^0.3.2",
    "@lapismd/mira": "~0.0.3",
    "@lapismd/mira-editor": "~0.0.2",
    "@lapismd/mira-plugin-ai": "~0.0.2",
    "@lapismd/mira-plugin-mermaid": "~0.0.2",
    "@lapismd/spec-validator": "^0.1.4",
    "@lapismd/storybook-addon-visual-delta": "0.0.7",
    "@lucide/svelte": "^0.523.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/icons": "^2.1.0",
    "@storybook/svelte-vite": "^10.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.12",
    "@tobilu/qmd": "2.5.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.8",
    "aria-query": "5.3.2",
    "bits-ui": "2.19.5",
    "character-entities": "2.0.2",
    "debug": "^4.4.3",
    "extend": "^3.0.2",
    "markdownlint": "^0.40.0",
    "playwright": "1.61.1",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "storybook": "^10.5.7",
    "svelte": "5.56.10",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.1",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0",
    "@lapismd/ai-controller": "^0.1.0",
    "@mdx-js/react": "^3.1.1",
    "@types/react": "^19.2.18",
    "@types/node": "^26.1.2"
  },
  "license": "Apache-2.0"
}
