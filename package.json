{
  "name": "lapis-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "check:svelte": "turbo run check:svelte",
    "check:types": "turbo run check:types",
    "dev": "pnpm storybook",
    "storybook": "storybook dev -p 7010 --no-open",
    "build-storybook": "node -e \"require('node:fs').mkdirSync('.visual-delta/cache',{recursive:true})\" && storybook build --stats-json .visual-delta/cache",
    "test:storybook": "vitest run --project storybook",
    "test:visual": "visual-delta test --affected --baseline-path-mode nested-import",
    "test:visual:update": "node ./scripts/update-api-visual-baselines.mjs",
    "spec:build": "mdbook build ./spec",
    "spec:check": "pnpm spec:build && pnpm spec:first",
    "spec:first": "node ./scripts/check-spec-first.mjs",
    "spec:serve": "mdbook serve ./spec --open",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@lapis-notes/ui": "workspace:*",
    "@lapismd/design-core": "link:../design-core",
    "@lapismd/storybook-addon-visual-delta": "^0.0.6",
    "@lucide/svelte": "^0.523.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/svelte-vite": "^10.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.12",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.8",
    "aria-query": "5.3.2",
    "playwright": "1.61.1",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.7",
    "svelte": "^5.38.2",
    "tailwindcss": "^4.1.12",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "adm-zip": ">=0.6.0",
      "aria-query": "5.3.2",
      "sharp": ">=0.35.0"
    }
  }
}
