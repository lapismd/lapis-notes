{
  "name": "lapis-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@lapis-notes/desktop-deno...",
    "build:web": "turbo run build --filter=@lapis-notes/web...",
    "changeset": "changeset",
    "check": "pnpm spec:validate && pnpm check:no-tailwind && pnpm check:app-ownership && pnpm check:metadata-queries && turbo run check",
    "check:all": "pnpm check && pnpm test && pnpm build",
    "check:app-ownership": "tsx scripts/check-ambient-app-ownership.ts",
    "check:metadata-queries": "tsx scripts/check-first-party-metadata-queries.ts",
    "check:no-tailwind": "tsx scripts/check-no-tailwind-utilities.ts",
    "check:svelte": "turbo run check:svelte",
    "check:types": "turbo run check:types",
    "ai-host": "pnpm exec lapis-ai-host",
    "terminal-host": "pnpm exec lapis-terminal-host",
    "ai:smoke:seed": "tsx scripts/ai-real-host.ts seed",
    "ai:smoke:storybook": "pnpm plugins:local:install && tsx scripts/ai-real-host.ts storybook",
    "ai:smoke:desktop": "pnpm plugins:local:install && tsx scripts/ai-real-host.ts desktop",
    "ai:smoke:probe:codex-acp": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts codex-acp",
    "ai:smoke:probe:cursor-acp": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts cursor-acp",
    "ai:smoke:probe:codex-native": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts codex-native",
    "ai:smoke:probe:handoff": "pnpm plugins:local:install && tsx scripts/ai-cross-agent-handoff-probe.ts",
    "test:ai:smoke-harness": "node --test scripts/lib/ai-real-host-fixture.test.mjs scripts/ai-host-storybook-boundary.test.mjs",
    "dev": "pnpm storybook",
    "plugins:local:install": "node scripts/prepare-local-plugin-consumer.mjs",
    "dev:desktop": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/desktop-deno dev",
    "dev:desktop:cef": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && LAPIS_DENO_BACKEND=cef pnpm --filter @lapis-notes/desktop-deno dev",
    "dev:desktop:chrome": "pnpm dev:desktop:cef",
    "dev:desktop:telemetry": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/desktop-deno dev:telemetry",
    "dev:desktop:telemetry:cef": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/desktop-deno dev:telemetry:cef",
    "telemetry:lgtm": "pnpm --filter @lapis-notes/desktop-deno telemetry:lgtm",
    "dev:web": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/web dev",
    "restart:web": "bash scripts/web-restart.sh",
    "storybook": "pnpm plugins:local:install && WATCHPACK_POLLING=250 node scripts/with-storybook-env.mjs node scripts/storybook-run.mjs --no-open",
    "storybook:stop": "node scripts/with-storybook-env.mjs bash scripts/storybook-stop.sh",
    "storybook:restart": "node scripts/with-storybook-env.mjs bash scripts/storybook-restart.sh",
    "build-storybook": "node -e \"require('node:fs').mkdirSync('.visual-delta/cache',{recursive:true})\" && NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" storybook build --stats-json .visual-delta/cache && pnpm check:storybook-index",
    "check:storybook-index": "node scripts/spec-validation/storybook-spec-index.mjs",
    "test:storybook": "vitest run --project storybook",
    "test:workspace:pointer": "node scripts/with-storybook-env.mjs playwright test -c playwright.workspace.config.ts",
    "test:visual": "node ./scripts/test-visual.mjs",
    "test:visual:update": "node ./scripts/update-visual-baselines.mjs",
    "spec:build": "spec-validator build",
    "spec:check": "spec-validator check && pnpm check:app-ownership && pnpm check:metadata-queries && pnpm test:spec-validation",
    "spec:first": "spec-validator first",
    "spec:index": "spec-validator index",
    "spec:search": "spec-validator search",
    "spec:validate": "spec-validator validate",
    "test:spec-validation": "node --test scripts/spec-validation/*.test.mjs",
    "spec:serve": "spec-validator serve",
    "test": "turbo run test",
    "packages:check": "node ./scripts/check-package-boundaries.mjs && node --test ./scripts/check-package-boundaries.spec.mjs && pnpm test:local-plugin-consumer && pnpm release:check && pnpm release:test",
    "packages:pack": "pnpm build && node ./scripts/check-package-tarballs.mjs",
    "release:check": "node ./scripts/check-release-config.mjs && node ./scripts/check-release-workflow.mjs",
    "release:intent": "node ./scripts/check-release-intent.mjs",
    "release:notes": "node ./scripts/create-github-releases.mjs",
    "release:plan": "node ./scripts/release-plan.mjs",
    "release:prepare": "node ./scripts/prepare-release.mjs",
    "release:publish": "node ./scripts/publish-release.mjs",
    "release:test": "node --test ./scripts/check-release-intent.spec.mjs ./scripts/check-release-workflow.spec.mjs ./scripts/create-github-releases.spec.mjs ./scripts/publish-release.spec.mjs ./scripts/release-manifest.spec.mjs ./scripts/release-plan.spec.mjs",
    "release:verify": "node ./scripts/verify-release.mjs",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "package:desktop": "pnpm --filter @lapis-notes/desktop-deno package:app",
    "test:desktop:packaged": "pnpm --filter @lapis-notes/desktop-deno test:packaged",
    "test:local-plugin-consumer": "node --test scripts/local-plugin-pnpmfile.test.mjs scripts/lib/local-plugin-consumer.test.mjs",
    "dist:desktop:mac:arm64": "pnpm --filter @lapis-notes/desktop-deno package:macos:arm64",
    "dist:desktop:mac:x64": "pnpm --filter @lapis-notes/desktop-deno package:macos:x64",
    "dist:desktop:linux:arm64": "pnpm --filter @lapis-notes/desktop-deno package:linux:arm64",
    "dist:desktop:linux:x64": "pnpm --filter @lapis-notes/desktop-deno package:linux:x64",
    "preview:web": "pnpm --filter @lapis-notes/web preview",
    "test:web:e2e": "pnpm --filter @lapis-notes/web test:e2e",
    "performance:metadata:native": "pnpm --filter @lapis-notes/api performance:metadata:native",
    "performance:metadata:wasm": "tsx scripts/metadata-performance-wasm.ts",
    "performance:metadata:stress:native": "pnpm --filter @lapis-notes/api performance:metadata:native -- --notes 100000 --runs 1 --no-enforce",
    "performance:metadata:stress:wasm": "tsx scripts/metadata-performance-wasm.ts --notes 100000 --runs 1 --no-enforce"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.4.3",
    "@lezer/lr": "^1.4.2",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@fontsource/source-code-pro": "^5.2.7",
    "@lapis-notes/api": "workspace:*",
    "@lapis-notes/ai": "^0.1.1",
    "@lapismd/ai-host": "^0.1.0",
    "@lapismd/terminal-host": "^0.1.0",
    "@lapis-notes/bases": "^0.1.1",
    "@lapis-notes/bookmarks": "^0.1.1",
    "@lapis-notes/file-explorer": "workspace:*",
    "@lapis-notes/graph": "^0.1.1",
    "@lapis-notes/markdown": "^0.1.1",
    "@lapis-notes/markdown-lint": "^0.1.0",
    "@lapis-notes/spellcheck": "^0.1.0",
    "@lapis-notes/history": "^0.1.1",
    "@lapis-notes/search": "^0.1.1",
    "@lapis-notes/source-editor": "^0.1.0",
    "@lapis-notes/wordcount": "^0.1.0",
    "@lapis-notes/ui": "workspace:*",
    "@lapis-notes/workspace": "workspace:*",
    "@lapismd/design-core": "^0.1.0",
    "@lapismd/mira": "^0.0.1",
    "@lapismd/mira-editor": "^0.0.1",
    "@lapismd/mira-plugin-ai": "^0.0.1",
    "@lapismd/mira-plugin-mermaid": "^0.0.1",
    "@lapismd/spec-validator": "0.1.0",
    "@lapismd/storybook-addon-visual-delta": "0.0.7",
    "@lucide/svelte": "^0.523.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/icons": "^2.1.0",
    "@storybook/svelte-vite": "^10.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.12",
    "@tobilu/qmd": "2.5.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.8",
    "aria-query": "5.3.2",
    "bits-ui": "2.18.1",
    "character-entities": "2.0.2",
    "debug": "^4.4.3",
    "extend": "^3.0.2",
    "markdownlint": "^0.40.0",
    "playwright": "1.61.1",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "storybook": "^10.5.7",
    "svelte": "^5.38.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.1",
    "turbo": "^2.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
