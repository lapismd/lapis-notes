{
  "name": "lapis-notes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "node scripts/validation.mjs run build",
    "build:web": "node scripts/validation.mjs run build:web",
    "changeset": "changeset",
    "check": "node scripts/validation.mjs run check",
    "check:all": "node scripts/validation.mjs run check:all",
    "check:app-ownership": "node scripts/validation.mjs run check:app-ownership",
    "check:metadata-queries": "node scripts/validation.mjs run check:metadata-queries",
    "check:no-tailwind": "node scripts/validation.mjs run check:no-tailwind",
    "check:svelte": "node scripts/validation.mjs run check:svelte",
    "check:types": "node scripts/validation.mjs run check:types",
    "terminal-host": "pnpm exec lapis-terminal-host",
    "ai:smoke:seed": "tsx scripts/ai-real-host.ts seed",
    "ai:smoke:storybook": "pnpm plugins:local:install && tsx scripts/ai-real-host.ts storybook",
    "ai:smoke:probe:codex-acp": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts codex-acp",
    "ai:smoke:probe:cursor-acp": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts cursor-acp",
    "ai:smoke:probe:codex-native": "pnpm plugins:local:install && tsx scripts/ai-real-agent-probe.ts codex-native",
    "ai:smoke:probe:handoff": "pnpm plugins:local:install && tsx scripts/ai-cross-agent-handoff-probe.ts",
    "test:ai:smoke-harness": "node scripts/validation.mjs run test:ai:smoke-harness",
    "dev": "pnpm storybook",
    "plugins:local:install": "node scripts/prepare-local-plugin-consumer.mjs",
    "dev:web": "pnpm plugins:local:install && pnpm --filter @lapis-notes/api build && pnpm --filter @lapis-notes/web dev",
    "restart:web": "bash scripts/web-restart.sh",
    "storybook": "pnpm plugins:local:install && WATCHPACK_POLLING=250 node scripts/with-storybook-env.mjs node scripts/storybook-run.mjs --no-open",
    "storybook:stop": "node scripts/with-storybook-env.mjs bash scripts/storybook-stop.sh",
    "storybook:restart": "node scripts/with-storybook-env.mjs bash scripts/storybook-restart.sh",
    "build-storybook": "node scripts/validation.mjs run build-storybook",
    "check:storybook-index": "node scripts/validation.mjs run check:storybook-index",
    "test:storybook": "node scripts/validation.mjs run test:storybook",
    "test:workspace:pointer": "node scripts/validation.mjs run test:workspace:pointer",
    "test:visual": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:visual:run --task-args",
    "test:visual:update": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:visual:update:run --task-args",
    "spec:build": "node scripts/validation.mjs run spec:build",
    "spec:check": "node scripts/validation.mjs run spec:check",
    "spec:first": "node scripts/validation.mjs run spec:first",
    "spec:index": "spec-validator index",
    "spec:search": "spec-validator search",
    "spec:validate": "node scripts/validation.mjs run spec:validate",
    "test:spec-validation": "node scripts/validation.mjs run test:spec-validation",
    "spec:serve": "spec-validator serve",
    "test": "node scripts/validation.mjs run test",
    "packages:policy": "node scripts/validation.mjs run packages:policy",
    "packages:check": "node scripts/validation.mjs run packages:check",
    "packages:pack": "node scripts/validation.mjs run packages:pack",
    "ci:packages": "node scripts/validation.mjs run ci:packages",
    "ci:release": "node scripts/validation.mjs run ci:release",
    "ci:container": "node --env-file-if-exists=.env scripts/run-ci-container.mjs",
    "release:check": "node ./scripts/check-release-config.mjs && node ./scripts/check-release-workflow.mjs && pnpm desktop:release:check",
    "release:intent": "node ./scripts/check-release-intent.mjs",
    "release:notes": "node ./scripts/create-github-releases.mjs",
    "release:plan": "node ./scripts/release-plan.mjs",
    "release:prepare": "node ./scripts/prepare-release.mjs",
    "release:publish": "node ./scripts/publish-release.mjs",
    "release:test": "node scripts/validation.mjs run release:test",
    "release:verify": "node ./scripts/verify-release.mjs",
    "release:version": "pnpm release:check && changeset version && pnpm install --lockfile-only && node scripts/generate-plugin-host-modules.mjs && pnpm release:check",
    "test:local-plugin-consumer": "node scripts/validation.mjs run test:local-plugin-consumer",
    "preview:web": "pnpm --filter @lapis-notes/web preview",
    "test:web:e2e": "node --env-file-if-exists=.env scripts/run-turbo.mjs test:web:e2e:run --task-args",
    "performance:metadata:native": "pnpm --filter @lapis-notes/api performance:metadata:native",
    "performance:metadata:wasm": "tsx scripts/metadata-performance-wasm.ts",
    "performance:metadata:stress:native": "pnpm --filter @lapis-notes/api performance:metadata:native -- --notes 100000 --runs 1 --no-enforce",
    "performance:metadata:stress:wasm": "tsx scripts/metadata-performance-wasm.ts --notes 100000 --runs 1 --no-enforce",
    "ai-controller": "lapis-ai-controller",
    "ci:storybook-static": "node scripts/validation.mjs run ci:storybook-static",
    "ci:storybook-interaction": "node scripts/validation.mjs run ci:storybook-interaction",
    "check:specification-docs": "node scripts/validation.mjs run check:specification-docs",
    "test:specification:dev": "node scripts/validation.mjs run test:specification:dev",
    "test:specification:static": "node scripts/validation.mjs run test:specification:static",
    "spec:mirrors": "node scripts/spec-validation/sync-specification.mjs --write",
    "test:ai:smoke-harness:run": "node --test scripts/lib/ai-real-host-fixture.test.mjs scripts/ai-host-storybook-boundary.test.mjs",
    "test:storybook:run": "node scripts/validation/storybook.mjs",
    "test:workspace:pointer:run": "node scripts/with-storybook-env.mjs playwright test -c playwright.workspace.config.ts",
    "test:visual:run": "node ./scripts/test-visual.mjs",
    "test:visual:update:run": "node ./scripts/update-visual-baselines.mjs",
    "test:spec-validation:run": "node --test scripts/spec-validation/*.test.mjs",
    "release:test:run": "node --test ./scripts/web-registry-acceptance.test.mjs ./scripts/storybook-turbo-cache.test.mjs ./scripts/ci-images.test.mjs ./scripts/dependency-image-pr.test.mjs ./scripts/ci-container.test.mjs ./scripts/check-release-intent.spec.mjs ./scripts/check-release-workflow.spec.mjs ./scripts/create-github-releases.spec.mjs ./scripts/publish-release.spec.mjs ./scripts/release-manifest.spec.mjs ./scripts/verify-release.spec.mjs ./scripts/release-plan.spec.mjs ./scripts/release-changelog.spec.mjs ./scripts/release-version.spec.mjs ./scripts/desktop-release.test.mjs ./scripts/desktop-release-workflow.test.mjs ./scripts/dependency-security.spec.mjs ./scripts/local-test-routing.test.mjs",
    "test:local-plugin-consumer:run": "node --test scripts/local-plugin-pnpmfile.test.mjs scripts/lib/local-plugin-consumer.test.mjs",
    "test:web:e2e:run": "node scripts/run-web-registry-acceptance.mjs",
    "test:specification:dev:run": "playwright test -c playwright.specification.config.ts",
    "test:specification:static:run": "SPECIFICATION_STATIC=1 playwright test -c playwright.specification.config.ts",
    "build-storybook:run": "node -e \"require('node:fs').mkdirSync('.visual-delta/cache',{recursive:true})\" && NODE_OPTIONS=\"${NODE_OPTIONS:---max-old-space-size=8192}\" storybook build --stats-json .visual-delta/cache && pnpm check:storybook-index",
    "test:spec-validation:view-commands": "node scripts/validation.mjs run test:spec-validation:view-commands",
    "test:spec-validation:view-commands:run": "node --test scripts/spec-validation/view-command-audit.test.mjs",
    "test:spec-validation:storybook-structure": "node scripts/validation.mjs run test:spec-validation:storybook-structure",
    "test:spec-validation:storybook-structure:run": "node --test scripts/spec-validation/storybook-structure-audit.test.mjs",
    "test:package-boundaries": "node scripts/validation.mjs run test:package-boundaries",
    "test:package-boundaries:run": "node --test ./scripts/check-package-boundaries.spec.mjs",
    "storybook:installed": "WATCHPACK_POLLING=250 node scripts/with-storybook-env.mjs node scripts/storybook-run.mjs --no-open",
    "desktop:release:check": "node scripts/check-desktop-release-workflow.mjs",
    "desktop:release:test": "node --test scripts/desktop-release.test.mjs scripts/desktop-release-workflow.test.mjs",
    "test:search:onnx": "node scripts/validation.mjs run test:search:onnx",
    "test:search:onnx:run": "node scripts/search-model-test.mjs",
    "validation:check": "node scripts/validation.mjs run validation:check",
    "validation:smoke": "node scripts/validation.mjs run validation:smoke",
    "validation": "node scripts/validation.mjs",
    "validation:images": "node scripts/validation.mjs images",
    "validation:doctor": "node scripts/validation.mjs doctor",
    "check:storybook-parity": "node scripts/validation.mjs run check:storybook-parity",
    "test:storybook-parity": "node scripts/validation.mjs run test:storybook-parity",
    "test:storybook-parity:run": "node --test scripts/spec-validation/storybook-parity.test.mjs",
    "validation:consumer-pack": "node scripts/validation.mjs run validation:consumer-pack",
    "validation:rust": "node scripts/validation.mjs run validation:rust",
    "capture:native-daily-reference": "node scripts/validation.mjs run capture:native-daily-reference",
    "test:native-daily-reference": "node scripts/validation.mjs run test:native-daily-reference",
    "test:api:native-tasks": "node scripts/validation.mjs run test:api:native-tasks",
    "capture:native-daily-locales-reference": "node scripts/validation.mjs run capture:native-daily-locales-reference",
    "test:native-daily-locales-reference": "node scripts/validation.mjs run test:native-daily-locales-reference",
    "test:web:workspace-leave": "node scripts/validation.mjs run test:web:workspace-leave",
    "test:native-daily-reference:run": "pnpm --filter @lapis-notes/api exec vitest run src/lib/native-daily-reference.test.ts",
    "test:api:native-tasks:run": "pnpm --filter @lapis-notes/api exec vitest run src/lib/__tests__/native-tasks.test.ts",
    "test:native-daily-locales-reference:run": "pnpm --filter @lapis-notes/api exec vitest run src/lib/native-daily-reference.test.ts src/lib/native-daily-en-gb-reference.test.ts src/lib/native-daily-en-us-week-reference.test.ts",
    "test:web:workspace-leave:run": "pnpm --filter @lapis-notes/web exec vitest run src/workspace/leave.test.ts",
    "web:cloudflare:build": "pnpm build:web && pnpm web:cloudflare:prepare",
    "web:cloudflare:prepare": "node scripts/prepare-cloudflare-web.mjs && wrangler types .cloudflare/worker-configuration.d.ts && pnpm web:cloudflare:check && wrangler deploy --dry-run --outdir .cloudflare/bundle",
    "web:cloudflare:check": "tsc -p packages/web/cloudflare/tsconfig.json",
    "web:cloudflare:test": "node --test scripts/prepare-cloudflare-web.test.mjs scripts/cloudflare-web.test.mjs",
    "web:cloudflare:smoke": "node scripts/smoke-cloudflare-web.mjs",
    "web:cloudflare:acceptance": "node scripts/test-cloudflare-artifact.mjs"
  },
